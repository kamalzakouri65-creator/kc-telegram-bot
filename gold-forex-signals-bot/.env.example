TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# اختياري
SYMBOLS=XAU/USD,EUR/USD,GBP/USD,USD/JPY
INTERVAL=1h
CHECK_EVERY_MINUTES=15
# الاستراتيجية: ema-macd أو pullback أو order-block أو smc، ويمكن أكثر من واحدة مثل ema-macd,pullback
STRATEGY=ema-macd
# إعدادات موقوفة (زوج:إطار:استراتيجية). بدون هذا السطر: الفضة 1h Pullback موقوفة. فارغ = لا شيء موقوف
DISABLED_SETUPS=XAG/USD:1h:pullback
# أقصى خسارة بالدولار في الصفقة اليدوية (حساب XM Micro)؛ الإشارة تقترح الحجم أو تقول تخطَّها. 0 لإخفاء السطر
MAX_LOSS_USD=3

# التداول الآلي على MetaTrader 5 عبر MetaApi (اختياري)
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNT_ID=your_metaapi_account_id_here
METAAPI_REGION=new-york
# لاحقة الرموز عند وسيطك إن وُجدت، مثل m في XAUUSDm
MT_SYMBOL_SUFFIX=
# أسماء مختلفة عند الوسيط، مثل الذهب عند XM: XAU/USD=GOLD
MT_SYMBOL_MAP=
AUTO_TRADE=false
RISK_PERCENT=1
MAX_OPEN_POSITIONS=3
ALLOW_REAL_TRADING=false
